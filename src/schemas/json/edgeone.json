{
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "main": {
      "type": "string"
    },
    "zone_id": {
      "type": "string"
    },
    "create_date": {
      "type": "string"
    },
    "dev": {
      "type": "object",
      "properties": {
        "port": {
          "type": [
            "number",
            "string"
          ]
        },
        "origin": {
          "type": "string"
        },
        "timeout": {
          "type": [
            "number",
            "string"
          ]
        },
        "sandbox": {
          "type": "boolean"
        },
        "favicon": {
          "type": "boolean"
        },
        "minify": {
          "type": "boolean"
        },
        "site": {
          "type": "object",
          "properties": {
            "assets_dir": {
              "type": "string"
            },
            "proxy_path": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "publish": {
      "type": "object",
      "properties": {
        "minify": {
          "type": "boolean"
        },
        "rule": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "condition": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "target": {
                      "type": "string"
                    },
                    "operator": {
                      "type": "string",
                      "enum": [
                        "equal",
                        "notequal"
                      ]
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "target",
                    "operator",
                    "values"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "condition"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "properties": {
        "monitor": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "target_file": {
          "type": "string"
        }
      },
      "required": [
        "target_file"
      ],
      "additionalProperties": false
    },
    "$schema": {
      "type": "string"
    },
    "outputDirectory": {
      "type": "string",
      "description": "the output directory relative to project root directory after run build command."
    },
    "installCommand": {
      "type": "string",
      "description": "the install command to run."
    },
    "buildCommand": {
      "type": "string",
      "description": "the build command to run."
    },
    "nodeVersion": {
      "type": "string",
      "description": "the node version to use."
    },
    "nodeFunctionsConfig": {
      "type": "object",
      "properties": {
        "maxDuration": {
          "type": "number",
          "minimum": 10,
          "maximum": 120
        }
      },
      "additionalProperties": false
    },
    "cloudFunctions": {
      "type": "object",
      "properties": {
        "maxDuration": {
          "type": "number",
          "minimum": 10,
          "maximum": 120,
          "description": "Maximum execution duration for a single invocation (seconds)"
        },
        "regions": {
          "type": "object",
          "properties": {
            "mainland": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "国内 SCF 部署地域, 如 [\"ap-beijing\"]"
            },
            "overseas": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "海外 SCF 部署地域, 如 [\"ap-tokyo\"]"
            }
          },
          "additionalProperties": false
        },
        "includeFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Glob patterns for files to include in the function bundle"
        },
        "externalNodeModules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Node modules to be treated as external dependencies"
        },
        "nodejs": {
          "type": "object",
          "properties": {
            "includeFiles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Glob patterns for files to include in the function bundle"
            },
            "externalNodeModules": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Node modules to be treated as external dependencies"
            },
            "maxDuration": {
              "type": "number",
              "minimum": 10,
              "maximum": 120,
              "description": "Maximum execution duration for a single invocation (seconds)"
            }
          },
          "additionalProperties": false
        },
        "python": {
          "type": "object",
          "properties": {
            "maxDuration": {
              "type": "number",
              "minimum": 10,
              "maximum": 120,
              "description": "Maximum execution duration for a single invocation (seconds)"
            }
          },
          "additionalProperties": false
        },
        "go": {
          "type": "object",
          "properties": {
            "maxDuration": {
              "type": "number",
              "minimum": 10,
              "maximum": 120,
              "description": "Maximum execution duration for a single invocation (seconds)"
            }
          },
          "additionalProperties": false
        },
        "mainlandRegions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "国内 SCF 部署地域, 如 [\"ap-shanghai\"]"
        },
        "overseasRegions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "海外 SCF 部署地域, 如 [\"ap-bangkok\"]"
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string",
          "description": "Directory containing agent route files, relative to project root"
        },
        "framework": {
          "type": "string",
          "enum": [
            "claude-agent-sdk",
            "openai-sdk",
            "openai-agents-sdk",
            "langgraph",
            "crewai",
            "deepagents"
          ],
          "description": "Agent framework hint for runtime adapters"
        },
        "runtime": {
          "type": "string",
          "pattern": "^(agent-node|agent-python):(\\d+|\\d+\\.\\d+\\.\\d+)(\\|(agent-node|agent-python):(\\d+|\\d+\\.\\d+\\.\\d+))*$",
          "description": "Agent runtime image tag, e.g. agent-node:1 or agent-python:1.2.0"
        },
        "timeout": {
          "type": "number",
          "minimum": 1,
          "maximum": 1800,
          "description": "Maximum execution duration for a single agent run (seconds)"
        },
        "idleTimeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 21600,
          "description": "Maximum idle time for an agent session before recycling (seconds)"
        },
        "maxLifetime": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800,
          "description": "Maximum lifetime of an agent session (seconds)"
        },
        "memoryQuota": {
          "type": "object",
          "properties": {
            "maxMessagesPerConversation": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "Maximum messages allowed in a single memory conversation"
            }
          },
          "additionalProperties": false,
          "description": "Agent memory quota settings"
        },
        "includeFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Glob patterns for files to include in the agent bundle"
        },
        "sandbox": {
          "type": "object",
          "properties": {
            "timeout": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "Sandbox instance lifetime/idle timeout in seconds"
            }
          },
          "additionalProperties": false,
          "description": "Sandbox configuration for agent runtime"
        },
        "externalNodeModules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Node modules to be treated as external dependencies for agent runtime"
        },
        "mcp": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether to expose an MCP Server endpoint (/mcp) for this agent"
            },
            "auth": {
              "type": "boolean",
              "description": "Whether to enable Bearer Token validation (compared against the MCP_SECRET_KEY environment variable)"
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "description": "MCP Server configuration: when enabled, the platform automatically exposes each agent route as an MCP Tool"
        }
      },
      "additionalProperties": false
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "timeout": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Sandbox instance lifetime/idle timeout in seconds"
        }
      },
      "additionalProperties": false
    },
    "headers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "headers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "required": [
                "key",
                "value"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "source",
          "headers"
        ],
        "additionalProperties": false
      }
    },
    "redirects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "permanent": {
            "type": "boolean"
          },
          "statusCode": {
            "type": "number",
            "enum": [
              307,
              301,
              302,
              308,
              303,
              304
            ]
          }
        },
        "required": [
          "source",
          "destination"
        ],
        "additionalProperties": false
      }
    },
    "rewrites": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "destination": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "destination"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "src": {
                "type": "string"
              },
              "dest": {
                "type": "string"
              }
            },
            "required": [
              "src",
              "dest"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "caches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "cacheTtl": {
            "type": "number"
          }
        },
        "required": [
          "source",
          "cacheTtl"
        ],
        "additionalProperties": false
      }
    },
    "node-functions": {
      "type": "object",
      "properties": {
        "included_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Glob patterns for files to include in the function bundle"
        },
        "included_files_base_path": {
          "type": "string",
          "description": "Base path for included_files patterns, defaults to project root"
        },
        "external_node_modules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Node modules to be treated as external dependencies"
        }
      },
      "additionalProperties": false,
      "description": "Node function specific configuration"
    },
    "edge-functions": {
      "type": "object",
      "properties": {
        "included_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Glob patterns for files to include in the function bundle"
        },
        "included_files_base_path": {
          "type": "string",
          "description": "Base path for included_files patterns, defaults to project root"
        },
        "external_node_modules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Node modules to be treated as external dependencies"
        }
      },
      "additionalProperties": false,
      "description": "Edge function specific configuration"
    },
    "schedules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Unique name for the schedule task within the project"
          },
          "cron": {
            "type": "string",
            "minLength": 1,
            "description": "Standard 5-field cron expression, e.g. */5 * * * *"
          },
          "timezone": {
            "type": "string",
            "description": "Timezone for cron parsing, e.g. Asia/Shanghai. Defaults to local system timezone at build time"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "DELETE",
              "PATCH",
              "HEAD"
            ],
            "default": "POST",
            "description": "HTTP method for the trigger request. Defaults to POST"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "HTTP path of the cloud function to trigger, e.g. /api/cron/tick"
          },
          "payload": {
            "type": "object",
            "additionalProperties": {},
            "description": "JSON payload to send with the trigger request"
          }
        },
        "required": [
          "name",
          "cron",
          "path"
        ],
        "additionalProperties": false
      },
      "maxItems": 10,
      "description": "Cron schedule tasks that trigger cloud functions"
    }
  },
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EdgeOne Project Configuration",
  "$id": "https://www.schemastore.org/edgeone.json"
}
